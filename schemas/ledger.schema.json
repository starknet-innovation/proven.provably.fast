{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "provenfast-ledger/0",
  "title": "proven.provably.fast soundness ledger",
  "type": "object",
  "required": ["schema", "entry", "floor_bits", "claims"],
  "properties": {
    "schema": {"const": "provenfast-ledger/0"},
    "entry": {"type": "string"},
    "floor_bits": {"type": "number", "minimum": 0},
    "parameters": {"type": "object", "description": "the entry's proof-system parameters, for the record"},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "component", "formula", "inputs", "status", "source"],
        "properties": {
          "id": {"type": "string", "pattern": "^C-[A-Z0-9-]+$"},
          "component": {"type": "string", "description": "a required component, optionally with :detail"},
          "regime": {"enum": ["conjectured-capacity", "johnson", "unique-decoding"]},
          "bounds": {"type": "string", "description": "the event whose probability the claim bounds"},
          "formula": {"enum": ["fri.queries", "grinding.pow", "schwartz-zippel", "fixed"]},
          "applies_to": {"type": "string", "description": "grinding.pow only: the claim it protects"},
          "inputs": {"type": "object"},
          "derivation": {"type": "string", "description": "required for fixed: how the error was computed"},
          "assumptions": {"type": "array", "items": {"type": "string"}},
          "source": {"type": "string"},
          "status": {"enum": ["LEAN-CHECKED", "REVIEWED", "CITED-UNCHECKED", "CONJECTURED"]},
          "reviewers": {
            "type": "array",
            "items": {"type": "object", "required": ["name", "human", "check"],
                      "properties": {"name": {"type": "string"}, "human": {"type": "boolean"},
                                     "check": {"type": "string", "description": "link to the written check"}}}
          }
        }
      }
    }
  }
}
