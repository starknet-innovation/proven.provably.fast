{
  // proven.provably.fast: the static site in docs/ and worker.js, served by Cloudflare. `npx wrangler
  // deploy` from the repository root publishes both; the custom domain is created with the deploy.
  // worker.js forwards the page's discussion and research-graph requests to provably.fast.
  "name": "proven-provably-fast",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./docs", "binding": "ASSETS" },
  // The provably.fast platform Worker (services/auth), which serves the participation API.
  "services": [{ "binding": "PLATFORM", "service": "provably-fast-auth" }],
  // The challenge this site is: provably.fast's research page (/workshop) keeps to it.
  "vars": { "SITE_CAMPAIGN": "proven-mca-graph-v1" },
  "routes": [{ "pattern": "proven.provably.fast", "custom_domain": true }],
  "workers_dev": false
}
